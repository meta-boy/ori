# ori Firecracker guest kernel config — the versioned artifact (v1)
#
# This file is a Kconfig fragment on top of Firecracker's recommended microvm
# config. Build procedure (exact commands in image/FC-KERNEL.md):
#
#   make x86_64/microvm_defconfig
#   cat <repo>/image/fc-kernel.config >> .config
#   make olddefconfig
#   # verify every symbol below survived (grep), then
#   make -j"$(nproc)" vmlinux
#
# Requirement set from docs/spikes/firecracker-driver.md §2: overlayfs,
# netfilter/iptables, bridge, veth, cgroup v2, PSI, virtio blk/net/vsock, ext4.
# Plus what a systemd-PID-1 guest running dockerd needs: namespaces, BPF/cgroup
# BPF, IPv6, TUN (dinD), serial console. Pinned for kernel v6.12 LTS.
#
# `make olddefconfig` silently DROPS symbols whose dependencies are unmet; the
# verification grep in FC-KERNEL.md is a build gate, not a nicety.

# --- filesystem --------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FS_POSIX_ACL=y
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y

# --- cgroups v2 + namespaces + BPF (systemd PID 1, dockerd) -------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUP_NS=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# --- PSI (host accounting; the driver reads guest stats) ----------------------
CONFIG_PSI=y

# --- networking: bridge, veth, tun, ipv6 --------------------------------------
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IPV6=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# --- netfilter / iptables / nftables (one MASQUERADE rule per host bridge) -----
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_CHAIN_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
# NFT_COMPAT is the xtables-over-nftables shim: Ubuntu 22.04's dockerd calls
# iptables-nft, which needs this to create its DOCKER nat chain. Without it a real
# ori guest boots but dockerd dies with "iptables: Failed to initialize nft:
# Protocol not supported" — the CI kernel's exact failure on first DinD boot.
CONFIG_NFT_COMPAT=y
# xtables match/target modules docker's iptables-nft ruleset appends (addrtype for
# its PREROUTING -m addrtype --dst-type LOCAL rule, conntrack, masquerade, redirect,
# comment, mark). Built static (=y) since the guest kernel has no modules; without
# them dockerd boots past nft init but dies with "RULE_APPEND failed (No such file
# or directory): rule in chain PREROUTING".
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y

# --- virtio blk / net / vsock (Firecracker device model) -----------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_BALLOON=y

# --- console (Firecracker serial; kernel cmdline console=ttyS0) ---------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
