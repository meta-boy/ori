# Control-plane Postgres (docker-compose.yml). External-only dependency for P2/P3.
DATABASE_URL=postgres://ori:ori@localhost:5432/ori

# MinIO (S3-compatible) used by the restic wrapper in P5. Local dev only.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ori-snapshots

# Ori server port.
PORT=8787
# Derives every ori's restic repository password:
#   HMAC-SHA256(ORI_SNAPSHOT_SECRET, "ori-snapshot-repo:" + oriId)
# LOSE THIS AND EVERY SNAPSHOT IN THE SYSTEM IS PERMANENTLY UNREADABLE. It is not
# rotatable, a bucket backup without it is worthless, and it must NEVER be given a code
# default — a fallback silently shares one password across every deployment that forgot
# to set it. Fail to start instead. See docs/OPERATIONS.md.
ORI_SNAPSHOT_SECRET=dev-only-change-me

# The address a ORI uses to reach the object store. It differs from S3_ENDPOINT under
# Docker: inside a container `localhost:9000` is the container itself, so a ori handed the
# control plane's address cannot reach minio at all. Verified working on Docker Desktop:
S3_ENDPOINT_FOR_ORI=http://host.docker.internal:9000

# Per-sandbox resource ceilings, applied to EVERY sandbox whatever its type asks for
# (a machine type is a request, not a promise the host can keep). On a small host this is
# what stops one sandbox from OOMing the control plane; the LXC installer (infra/lxc/ori.sh)
# writes these automatically from the container's own size. Unset = the type's own numbers.
# ORI_SANDBOX_MAX_CPUS=4
# ORI_SANDBOX_MAX_MEMORY_MB=8192
