# infra/env/agent.env.example -> seeded to /etc/ori/agent.env inside each ori by
# the Incus driver / cloud-init at provision time. NOT created by bootstrap.sh
# on the host; shown only to pin the contract for ori-guest-agent.service.
#
# The agent token is unique per ori and is read from this file so it never
# appears on the guest agent's command line.
ORI_ID=or_xxxxxxxx
ORI_AGENT_TOKEN=changeme-per-ori
# Control plane as seen from inside the ori (the routed-subnet gateway).
CONTROL_PLANE_BASE=http://10.10.0.1:8080