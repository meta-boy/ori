# infra/env/ori-api.env.example -> copy to /etc/ori/ori-api.env (bootstrap.sh does this)
# Control plane runtime settings (see ori-api.service).
#
# PORT is the control-plane listen port. It is load-bearing: the host firewall
# opens it to the ori subnet, and the edge's CONTROL_PLANE_BASE must match.
# Keep 8080 unless you also update the firewall + caddy env together.
PORT=8080
# Postgres DSN for the control plane's store.
DATABASE_URL=postgres://ori:CHANGEME@127.0.0.1:5432/ori