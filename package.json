{
  "name": "ori",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test test/api test/contract packages/*",
    "typecheck": "bunx tsc --noEmit && bun run --cwd packages/dashboard typecheck",
    "lint": "bunx tsc --noEmit",
    "db:generate": "bun run --cwd packages/api db:generate",
    "db:check": "bun run --cwd packages/api db:check",
    "db:migrate": "bun run --cwd packages/api db:migrate",
    "db:reset": "bun run packages/api/scripts/reset.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "drizzle-kit": "^0.31.0",
    "js-yaml": "^5.2.3",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "hono": "^4.13.0",
    "postgres": "^3.4.5",
    "zod": "^4.0.0"
  }
}