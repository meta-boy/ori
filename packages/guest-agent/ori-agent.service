# ori-agent.service — the in-ori guest agent (port 7777)
#
# Installed inside every ori at /etc/systemd/system/ori-agent.service. The image's
# provision.sh already writes this unit and the driver/cloud-init enables it after
# injecting the real binary at /opt/ori/guest-agent/ori-agent.
#
# Identity + credential come from /etc/ori.env (ORI_ID, ORI_AGENT_TOKEN), which the
# control plane seeds at provision time. Using an EnvironmentFile (not argv) keeps
# the token out of `ps`/`/proc`.
[Unit]
Description=ori guest agent (:7777)
ConditionPathExists=/opt/ori/guest-agent/ori-agent
After=network-online.target

[Service]
ExecStart=/opt/ori/guest-agent/ori-agent
EnvironmentFile=/etc/ori.env
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
